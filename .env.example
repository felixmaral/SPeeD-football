# Copia este fichero a `.env` y rellena los valores. NUNCA commitees `.env`.

# --- Modo de ejecución ---
# Si es "true" se usa el adaptador mock de fixtures (sin red). Útil en dev/CI.
WCPREDICTOR_USE_MOCK=true

# --- Proveedor de datos (API-Football) [fase 2+] ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Telegram bot [fase v1.0] ---
TELEGRAM_BOT_TOKEN=
# Lista de IDs autorizados separados por coma (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# --- General ---
WCPREDICTOR_LOG_LEVEL=INFO
WCPREDICTOR_TIMEZONE=Europe/Madrid
